{
  // Cloudflare Worker 설정. name 은 Cloudflare 대시보드의 Worker 이름과 같아야 한다.
  "name": "nihongo-study",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Worker를 Google Cloud 미국 동부 리전 가까이에서 실행한다.
  // (가까운 지역 서버에서 실행되면 Gemini가 "지원하지 않는 지역"으로 거절하는 경우가 있음)
  "placement": {
    "region": "gcp:us-east4"
  },
  // 대시보드에서 넣은 값(Secret 포함)을 배포할 때 지우지 않는다.
  "keep_vars": true,
  // 공개돼도 되는 값만 여기에 둔다. Gemini 키와 이메일은 대시보드에 Secret 으로 넣는다.
  "vars": {
    "SUPABASE_URL": "https://zblbrabphcecrlvjxzey.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_Xr9sjL91Si3PFMEGb4CIqQ_h4Rycc-E"
  }
}
